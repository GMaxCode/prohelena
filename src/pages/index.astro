---
// src/pages/index.astro
// HOME COMPLETA — Hero + Quem é a Helena + Como funciona +
// Prova social + Passos + FAQ + CTA final.

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroIntro from '../components/HeroIntro.astro';
import '../styles/tema.css';
import Reveal from '../components/Reveal.astro';
import QuemEhHelena from '../components/QuemEhHelena.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import ProvaSocial from '../components/ProvaSocial.astro';
import Passos from '../components/Passos.astro';
import Valores from '../components/Valores.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';

const title = 'Helena Dantas — Instrutora autônoma de direção em Sumaré/SP e região | Aulas práticas de CNH';
const description =
  'Aulas práticas de carro em Sumaré/SP e região para a primeira CNH ou para quem tem medo de dirigir. Você marca o ritmo. WhatsApp +55 19 99318-8336.';
---

<BaseLayout title={title} description={description} h1="Aprenda a dirigir em Sumaré/SP e região com a Helena — instrutora autônoma CNH do Brasil">
  <HeroIntro />
  <QuemEhHelena />
  <div class="tema-escuro">
  <ComoFunciona />
  <ProvaSocial />
  <Passos />
  <Valores />
  <Faq />
  <CtaFinal />
  </div>
  <Reveal />
</BaseLayout>
