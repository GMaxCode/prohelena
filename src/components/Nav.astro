---
// src/components/Nav.astro
// Header sticky simples. Mobile: hambúrguer com JS nativo.
// §8 — Mobile: hambúrguer até md, inline a partir de md.
import { site } from '../data/site';

const navLinks = [
  { href: '/#como-funciona', label: 'Como funciona' },
  { href: '/#primeira-habilitacao', label: 'Passo a passo' },
  { href: '/#valores', label: 'Valores' },
  { href: '/#faq', label: 'Dúvidas' },
  { href: '/primeira-habilitacao-sp', label: 'Guia completo' },
];
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <a href="/" class="nav-brand" aria-label={`${site.nome} — ir para a home`}>{site.nome}</a>

    <nav id="nav-menu" class="nav-menu" data-nav-menu aria-label="Navegação principal">
      <ul class="nav-list">
        {
          navLinks.map((l) => (
            <li>
              <a href={l.href} class="nav-link">{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      class="nav-wpp" data-umami-event="whatsapp_click"
      href={site.whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Falar com a Helena no WhatsApp (${site.whatsappFormatado})`}
      title="WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M12 2.5a9.4 9.4 0 0 0-8 14.3L2.7 21.5l4.8-1.3A9.4 9.4 0 1 0 12 2.5zm0 1.8a7.6 7.6 0 1 1-3.9 14.1l-.3-.2-2.8.8.8-2.7-.2-.3A7.6 7.6 0 0 1 12 4.3zM9 7.9c-.3 0-.6.2-.8.5-.4.6-.5 1.4 0 2.3.9 1.8 3 3.8 4.9 4.5.9.3 1.7.1 2.2-.4.2-.3.3-.7.2-1l-1.6-.8c-.2-.1-.5 0-.6.2l-.4.5c-1.2-.4-2.2-1.4-2.6-2.5l.5-.5c.2-.2.2-.4.1-.6L9.6 8.2c-.1-.2-.4-.3-.6-.3z" />
      </svg>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-controls="nav-menu"
      aria-expanded="false"
      aria-label="Abrir menu de navegação"
      data-nav-toggle
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </div>
</header>

<script>
  // JS mínimo: toggle do menu mobile. Zero deps.
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = header?.querySelector<HTMLElement>('[data-nav-menu]');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    toggle.setAttribute('aria-label', expanded ? 'Abrir menu de navegação' : 'Fechar menu de navegação');
    menu?.classList.toggle('is-open', !expanded);
    document.body.classList.toggle('nav-open', !expanded);
  });

  // Fecha menu ao clicar em qualquer link interno.
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('is-open');
      document.body.classList.remove('nav-open');
    })
  );
</script>

<style>
  /* Menu escuro e minimalista. Cores fixas: não herdam o tema invertido. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #0e0e10;
    color: #f7f3ec;
    border-bottom: 1px solid rgba(247, 243, 236, 0.12);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
  }
  .nav-brand {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.03em;
    color: #f7f3ec;
    text-decoration: none;
  }
  .nav-brand:hover { text-decoration: none; }

  .nav-wpp {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--signal);
    color: #f7f3ec;
    transition: transform 200ms var(--ease-out);
    animation: pulso 2.6s ease-out infinite;
  }
  .nav-wpp:hover { transform: scale(1.1); text-decoration: none; }
  @keyframes pulso {
    0% { box-shadow: 0 0 0 0 rgba(44, 143, 79, 0.55); }
    70%, 100% { box-shadow: 0 0 0 12px rgba(44, 143, 79, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .nav-wpp { animation: none; } }

  .nav-toggle {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    background: transparent;
  }
  .nav-toggle-bar {
    width: 24px;
    height: 2px;
    background: #f7f3ec;
    transition: transform 200ms var(--ease-out);
  }
  [aria-expanded='true'] .nav-toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  [aria-expanded='true'] .nav-toggle-bar:nth-child(2) { opacity: 0; }
  [aria-expanded='true'] .nav-toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav-menu {
    display: none;
    position: absolute;
    inset: 64px 0 auto 0;
    background: #0e0e10;
    border-bottom: 1px solid rgba(247, 243, 236, 0.12);
    padding: var(--space-5) var(--gutter);
  }
  .nav-menu.is-open { display: block; }
  .nav-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .nav-link { font-weight: 500; color: #f7f3ec; opacity: 0.85; text-decoration: none; }
  .nav-link:hover { opacity: 1; text-decoration: none; }

  @media (min-width: 768px) {
    .nav-toggle { display: none; }
    .nav-menu {
      display: flex !important;
      position: static;
      padding: 0;
      border: 0;
      background: transparent;
      flex: 1;
      justify-content: center;
    }
    .nav-list { flex-direction: row; align-items: center; gap: var(--space-6); }
    .nav-wpp { margin-left: 0; }
  }

  :global(body.nav-open) { overflow: hidden; }
</style>
