---
// src/components/WppFab.astro
// §8 PLANO — Botão WhatsApp flutuante visível no mobile a partir do 2º scroll.
// Esconde o FAB se a seção CTA final estiver em vista (evita sobreposição).
import { site, linkWhatsApp } from '../data/site';
---

<a
  class="wpp-fab" data-umami-event="whatsapp_click"
  href={linkWhatsApp()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Falar com a Helena no WhatsApp (${site.whatsappFormatado})`}
  data-wpp-fab
>
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M16 3C9.4 3 4 8.4 4 15c0 2.5.8 4.8 2.1 6.7L4 28.4l6.9-1.8c1.8 1 3.9 1.5 6 1.5h.1c6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.9h-.1c-2 0-4-.5-5.7-1.5l-.4-.2-4.1 1.1 1.1-4-.3-.4C5 18 4.3 15.7 4.3 13.4 4.3 8.7 8.7 4.3 13.4 4.3c2.3 0 4.5.9 6.1 2.5s2.5 3.8 2.5 6.1c0 4.7-3.8 8.5-8.5 8.5zm4.7-6.4c-.3-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.1-.5 0c-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.3 0-.5s-.7-1.6-.9-2.2c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.5 1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.3.2 1.8.1.6-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2 0-.1-.2-.2-.5-.3z"
    />
  </svg>
</a>

<script>
  const fab = document.querySelector<HTMLAnchorElement>('[data-wpp-fab]');
  if (fab) {
    const toggleVisible = () => {
      // Aparece a partir do 2º scroll viewport.
      const visible = window.scrollY > window.innerHeight;
      fab.classList.toggle('is-visible', visible);
    };
    toggleVisible();
    let raf = 0;
    window.addEventListener(
      'scroll',
      () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          toggleVisible();
          raf = 0;
        });
      },
      { passive: true }
    );
  }
</script>

<style>
  .wpp-fab {
    display: none;
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--signal);
    color: var(--paper);
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
    transition: transform 250ms var(--ease-out), opacity 250ms var(--ease-out);
    opacity: 0;
    transform: translateY(20px);
  }
  .wpp-fab:hover {
    transform: translateY(-2px) scale(1.05);
    text-decoration: none;
  }
  .wpp-fab svg {
    width: 28px;
    height: 28px;
  }
  .wpp-fab.is-visible {
    display: inline-flex;
    opacity: 1;
    transform: translateY(0);
  }

  @media (min-width: 1024px) {
    /* Em desktop o FAB atrapalha o layout — só mobile. */
    .wpp-fab { display: none; }
    .wpp-fab.is-visible { display: none; }
  }
</style>
