---
import WppButton from './WppButton.astro';
import { linkWhatsApp } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <p class="kicker">Helena Dantas · Sumaré/SP e região</p>
    <h1 id="hero-title">Aprenda a dirigir com confiança, no seu ritmo.</h1>
    <p>Aulas práticas de carro para a primeira CNH e para quem quer superar o medo de dirigir. A Helena acompanha você, com paciência e carro com duplo comando.</p>
    <WppButton href={linkWhatsApp('Olá Helena! Quero saber mais sobre as aulas de direção.')} />
    <a class="guia" href="#primeira-habilitacao">Veja o passo a passo da primeira habilitação ↓</a>
  </div>
</section>
<style>
  .hero { padding: clamp(3rem, 8vw, 7rem) 0; background: var(--paper); color: var(--ink); }
  .hero h1 { max-width: 18ch; margin: 1rem 0 1.5rem; }
  .hero p { margin-bottom: 1.5rem; }
  .kicker { color: var(--stop); font-size: var(--text-sm); font-family: var(--font-mono); }
  .guia { display: block; width: fit-content; margin-top: 1.5rem; color: inherit; }
</style>
