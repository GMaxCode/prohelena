---
// src/components/Hero.astro
// §4 PLANO adaptado: split hero interativo SEM vídeo, com cena SVG
// de autoescola (carro, rua, placas) animadas em CSS.
// Paleta pastel moderna isolada do hero, sem fugir do PLANO no resto do site.
import WppButton from './WppButton.astro';
import { site, linkWhatsApp } from '../data/site';

const kicker = `${site.cidade}/${site.uf} e região · CNH do Brasil`;
---

<section class="hero" aria-labelledby="hero-headline">
  <div class="hero-grid container">
    <!-- Cena SVG interativa: AUTOESCOLA -->
    <div class="hero-scene" aria-hidden="true">
      <svg
        class="scene-svg"
        viewBox="0 0 600 600"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        focusable="false"
      >
        <defs>
          <!-- Gradiente céu pastel -->
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#FFE9C9" />
            <stop offset="1" stop-color="#FFC7D8" />
          </linearGradient>
          <!-- Chão -->
          <linearGradient id="ground" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#C9F0E1" />
            <stop offset="1" stop-color="#9ED9C7" />
          </linearGradient>
          <!-- Asfalto -->
          <linearGradient id="road" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3F3D56" />
            <stop offset="1" stop-color="#2A2839" />
          </linearGradient>
          <!-- Carro -->
          <linearGradient id="car-body" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#FF9AA9" />
            <stop offset="1" stop-color="#E96E80" />
          </linearGradient>
          <linearGradient id="car-glass" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#9DD8F2" />
            <stop offset="1" stop-color="#5FA9C9" />
          </linearGradient>
          <!-- Nuvens -->
          <radialGradient id="cloud">
            <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.9" />
            <stop offset="1" stop-color="#FFFFFF" stop-opacity="0" />
          </radialGradient>
        </defs>

        <!-- Céu -->
        <rect width="600" height="420" fill="url(#sky)" />
        <!-- Nuvens (animadas com CSS) -->
        <g class="clouds">
          <ellipse cx="120" cy="80" rx="60" ry="20" fill="url(#cloud)" />
          <ellipse cx="200" cy="60" rx="50" ry="18" fill="url(#cloud)" />
          <ellipse cx="400" cy="100" rx="70" ry="22" fill="url(#cloud)" />
          <ellipse cx="500" cy="70" rx="45" ry="16" fill="url(#cloud)" />
        </g>

        <!-- Sol -->
        <circle class="sun" cx="490" cy="120" r="38" fill="#FFD56B" />
        <circle class="sun-glow" cx="490" cy="120" r="56" fill="#FFD56B" fill-opacity="0.25" />

        <!-- Prédios distantes (silhueta urbana simples) -->
        <g class="city" fill="#A7B5D9">
          <rect x="0" y="280" width="60" height="140" />
          <rect x="60" y="240" width="80" height="180" />
          <rect x="140" y="270" width="50" height="150" />
          <rect x="240" y="220" width="70" height="200" />
          <rect x="310" y="260" width="60" height="160" />
          <rect x="370" y="240" width="80" height="180" />
          <rect x="450" y="280" width="50" height="140" />
          <rect x="500" y="250" width="100" height="170" />
        </g>
        <!-- Janelas -->
        <g fill="#FFE9C9" opacity="0.6">
          <rect x="75" y="260" width="8" height="12" />
          <rect x="95" y="260" width="8" height="12" />
          <rect x="75" y="290" width="8" height="12" />
          <rect x="95" y="290" width="8" height="12" />
          <rect x="255" y="240" width="8" height="12" />
          <rect x="275" y="240" width="8" height="12" />
          <rect x="255" y="270" width="8" height="12" />
          <rect x="275" y="270" width="8" height="12" />
          <rect x="385" y="260" width="8" height="12" />
          <rect x="405" y="260" width="8" height="12" />
          <rect x="385" y="290" width="8" height="12" />
          <rect x="405" y="290" width="8" height="12" />
          <rect x="515" y="270" width="8" height="12" />
          <rect x="535" y="270" width="8" height="12" />
          <rect x="565" y="270" width="8" height="12" />
        </g>

        <!-- Chão (grama + asfalto) -->
        <rect x="0" y="420" width="600" height="180" fill="url(#ground)" />
        <!-- Rua -->
        <rect x="0" y="430" width="600" height="160" fill="url(#road)" />
        <!-- Faixas centrais (tracejadas) animadas -->
        <g class="lane-stripes">
          <rect x="-100" y="510" width="80" height="6" fill="#FFD56B" />
          <rect x="-30" y="510" width="80" height="6" fill="#FFD56B" />
          <rect x="60" y="510" width="80" height="6" fill="#FFD56B" />
          <rect x="160" y="510" width="80" height="6" fill="#FFD56B" />
          <rect x="260" y="510" width="80" height="6" fill="#FFD56B" />
          <rect x="360" y="510" width="80" height="6" fill="#FFD56B" />
          <rect x="460" y="510" width="80" height="6" fill="#FFD56B" />
        </g>

        <!-- Postes / placas no acostamento -->
        <g class="signpost">
          <!-- Poste 1 -->
          <rect x="50" y="350" width="6" height="90" fill="#3F3D56" />
          <rect x="30" y="345" width="46" height="34" rx="3" fill="#FF9AA9" />
          <text x="53" y="368" text-anchor="middle" font-family="Bebas Neue, Arial Narrow, sans-serif" font-size="22" fill="#FFFFFF">PARE</text>

          <!-- Poste 2 -->
          <rect x="170" y="370" width="6" height="70" fill="#3F3D56" />
          <circle cx="173" cy="380" r="20" fill="#FFFFFF" stroke="#3F3D56" stroke-width="5" />
          <text x="173" y="388" text-anchor="middle" font-family="Bebas Neue, Arial Narrow, sans-serif" font-size="22" fill="#3F3D56">30</text>

          <!-- Semáforo 3 -->
          <rect x="430" y="320" width="10" height="120" fill="#3F3D56" />
          <rect x="418" y="320" width="34" height="78" rx="8" fill="#2A2839" />
          <circle class="light-red" cx="435" cy="338" r="7" fill="#FF6E80" />
          <circle class="light-amber" cx="435" cy="360" r="7" fill="#FFD56B" />
          <circle class="light-green" cx="435" cy="382" r="7" fill="#9ED9C7" />
        </g>

        <!-- Carro (escola) com motorista/instrutora -->
        <g class="car">
          <!-- Sombra -->
          <ellipse cx="320" cy="540" rx="135" ry="10" fill="#000" fill-opacity="0.18" />
          <!-- Corpo do carro -->
          <rect x="200" y="450" width="240" height="70" rx="14" fill="url(#car-body)" />
          <!-- Capô / teto -->
          <path d="M 215 450 Q 220 410 270 410 L 370 410 Q 420 410 425 450 Z" fill="url(#car-body)" />
          <!-- Janelas -->
          <path d="M 232 448 Q 240 422 272 422 L 312 422 Q 304 448 304 448 Z" fill="url(#car-glass)" />
          <path d="M 308 422 L 362 422 Q 388 422 396 448 L 308 448 Z" fill="url(#car-glass)" />
          <!-- Faixa "AUTOESCOLA" no capô -->
          <rect x="290" y="404" width="120" height="8" rx="2" fill="#FFFFFF" />
          <text x="350" y="411" text-anchor="middle" font-family="Bebas Neue, Arial Narrow, sans-serif" font-size="9" fill="#3F3D56" letter-spacing="2">AUTOESCOLA</text>
          <!-- Rodas -->
          <circle cx="245" cy="525" r="22" fill="#1B1B1F" />
          <circle cx="245" cy="525" r="10" fill="#5C5C66" />
          <circle cx="395" cy="525" r="22" fill="#1B1B1F" />
          <circle cx="395" cy="525" r="10" fill="#5C5C66" />
          <!-- Farol -->
          <ellipse cx="206" cy="478" rx="6" ry="4" fill="#FFE066" />
          <!-- "L" amarelo de aprendiz -->
          <rect x="406" y="450" width="22" height="26" rx="3" fill="#FFD56B" stroke="#3F3D56" stroke-width="2" />
          <text x="417" y="470" text-anchor="middle" font-family="Bebas Neue, Arial Narrow, sans-serif" font-size="22" fill="#3F3D56">L</text>
          <!-- Motorista (silhueta) -->
          <circle cx="294" cy="416" r="9" fill="#3F3D56" />
          <rect x="287" y="424" width="14" height="14" rx="3" fill="#FF9AA9" />
          <!-- Volante -->
          <circle cx="294" cy="442" r="5" fill="none" stroke="#3F3D56" stroke-width="2" />
        </g>
      </svg>
    </div>

    <!-- Texto + CTA -->
    <div class="hero-content">
      <p class="hero-kicker">{kicker}</p>
      <h1 id="hero-headline" class="hero-headline">
        Aprenda a dirigir em {site.cidade}/{site.uf} e região com a {site.nome}
      </h1>
      <p class="hero-sub">
        <strong>Instrutora autônoma credenciada CNH do Brasil.</strong>
        Aulas práticas de carro para a sua primeira CNH — e também para quem tem medo de dirigir. Você marca o ritmo; eu te acompanho.
      </p>
      <div class="hero-actions">
        <WppButton href={linkWhatsApp(site.whatsappMensagemPadrao)} />
        <a class="btn btn--soft hero-secondary" href="#primeira-habilitacao">
          Ver passo a passo
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(160deg, #FFE9C9 0%, #FFC7D8 60%, #C9F0E1 100%);
    color: var(--ink);
    padding: var(--space-7) 0 var(--space-9);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .hero-content {
    text-align: center;
  }
  .hero-content > * { margin-inline: auto; }

  .hero-kicker {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--stop);
    margin-bottom: var(--space-3);
    max-width: none;
    font-size: var(--text-sm);
  }
  .hero-headline {
    color: var(--ink);
    margin-bottom: var(--space-4);
    max-width: 18ch;
  }
  .hero-sub {
    font-size: var(--text-lg);
    color: var(--ink);
    opacity: 0.86;
    max-width: 50ch;
    margin: 0 auto var(--space-6);
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
    justify-content: center;
  }
  /* No hero pastel, botão WhatsApp verde fica deslocado. Troco pra cor pastel coerente. */
  .hero :global(.btn--wpp) {
    --btn-bg: #FF8FA3;
    --btn-fg: var(--paper);
    border-color: var(--ink);
  }
  .hero-secondary {
    background: rgba(255, 255, 255, 0.55);
    color: var(--ink);
    border-color: var(--ink);
  }

  .hero-scene {
    position: relative;
  }
  .scene-svg {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
    /* Sombra suave pra dar volume, sem virar "cartão" pesado */
    filter: drop-shadow(0 18px 30px rgba(63, 61, 86, 0.12));
  }

  /* ===== Animações CSS da cena ===== */

  /* Carro balança levemente como se andando em rua com solavancos */
  @keyframes car-bounce {
    0%, 100% { transform: translateY(0); }
    25% { transform: translateY(-1.5px); }
    75% { transform: translateY(1.5px); }
  }
  .car { transform-origin: 320px 500px; animation: car-bounce 600ms ease-in-out infinite; }

  /* Sol pulsa suave */
  @keyframes sun-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }
  .sun { transform-origin: 490px 120px; animation: sun-pulse 4s ease-in-out infinite; }
  @keyframes sun-glow-pulse {
    0%, 100% { opacity: 0.25; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.18); }
  }
  .sun-glow { transform-origin: 490px 120px; animation: sun-glow-pulse 4s ease-in-out infinite; }

  /* Nuvens vagando bem devagar */
  @keyframes cloud-drift-1 {
    from { transform: translateX(0); }
    to   { transform: translateX(40px); }
  }
  @keyframes cloud-drift-2 {
    from { transform: translateX(0); }
    to   { transform: translateX(-30px); }
  }
  .clouds ellipse:nth-child(1) { animation: cloud-drift-1 16s ease-in-out infinite alternate; }
  .clouds ellipse:nth-child(3) { animation: cloud-drift-2 22s ease-in-out infinite alternate; }

  /* Faixas da rua deslizando pra dar sensação de movimento */
  @keyframes lane-slide {
    from { transform: translateX(0); }
    to   { transform: translateX(-160px); }
  }
  .lane-stripes { animation: lane-slide 0.8s linear infinite; }

  /* Semáforo trocando de luz pra dar vida */
  @keyframes light-off {
    0%, 49%, 71%, 100% { opacity: 0.35; }
    50%, 70% { opacity: 1; }
  }
  .light-red   { animation: light-off 4s infinite; }
  .light-amber { animation: light-off 4s infinite reverse; }
  .light-green { animation: light-off 4s infinite; animation-delay: 2s; }

  @media (prefers-reduced-motion: reduce) {
    .car, .sun, .sun-glow, .clouds ellipse, .lane-stripes,
    .light-red, .light-amber, .light-green { animation: none; }
  }

  /* Desktop: split real */
  @media (min-width: 1024px) {
    .hero {
      min-height: 80vh;
      display: flex;
      align-items: center;
    }
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      align-items: center;
    }
    .hero-content {
      text-align: left;
    }
    .hero-content > * { margin-inline: 0; }
    .hero-actions {
      flex-direction: row;
      justify-content: flex-start;
      gap: var(--space-3);
    }
  }
</style>
