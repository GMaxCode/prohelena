---
// src/components/QuemEhHelena.astro
// §3 PLANO — Foto principal + 3 parágrafos + cidades-irmãs (SEO local).
import { Image } from 'astro:assets';
import { site } from '../data/site';
import irmaos from '../assets/photos/irmaos.jpeg';
---

<section class="quem" aria-labelledby="quem-titulo">
  <div class="container quem-grid">
    <figure class="quem-foto">
      <Image
        src={irmaos}
        alt={`${site.nome} e o irmão Adriano — instrutora de direção`}
        width={640}
        height={640}
        loading="lazy"
        decoding="async"
        widths={[320, 480, 640, 960]}
        sizes="(min-width: 768px) 50vw, 100vw"
        format="webp"
        quality={78}
      />
    </figure>

    <div class="quem-texto">
      <p class="kicker">Quem é a {site.nome}</p>
      <h2 id="quem-titulo">Instrutora autônoma.</h2>

      <p>
        Sou a {site.nome}, instrutora autônoma de direção em {site.cidade}/{site.uf} e região.
      </p>
      <p>
        Dou aulas para qualquer pessoa: do jovem que vai tirar a primeira CNH ao adulto
        que recomeçou do zero — inclusive para quem tem medo de dirigir. Sem pressa,
        sem aula engessada, sem julgamento: o ritmo é o seu.
      </p>
      <p>
        O carro é meu, com duplo comando. Você aprende no trânsito real de {site.cidade}
        e região, não em circuito fechado.
      </p>

      <p class="quem-social">
        <a
          href={site.instagramLink}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Instagram da ${site.nome} (@${site.instagram})`}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.4A6.4 6.4 0 1 0 18.4 12 6.4 6.4 0 0 0 12 5.6zm0 10.6A4.2 4.2 0 1 1 16.2 12 4.2 4.2 0 0 1 12 16.2zm6.6-10.9a1.5 1.5 0 1 1-1.5-1.5 1.5 1.5 0 0 1 1.5 1.5z" />
          </svg>
          Me chama no Instagram: @{site.instagram}
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .quem {
    padding: var(--space-9) 0;
    background: var(--paper);
  }
  .quem-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: center;
  }
  .quem-foto img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    border-radius: var(--radius-md);
    filter: grayscale(0.06) brightness(0.97);
    transition: filter 250ms var(--ease-out);
  }
  .quem-foto img:hover { filter: none; }

  .kicker {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--stop);
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
  }
  .quem-texto h2 { margin-bottom: var(--space-4); }
  .quem-texto p { margin-bottom: var(--space-4); }
  .quem-social a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--stop);
  }
  .quem-social a:hover { color: var(--ink); }

  @media (min-width: 768px) {
    .quem-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-8);
    }
  }
</style>
