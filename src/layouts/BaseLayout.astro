---
// src/layouts/BaseLayout.astro
// Layout raiz de TODA página. Head, skip link, <main>, footer.
// Single <h1> por página é responsabilidade de quem chama (passa via prop).

import '@fontsource-variable/inter';
import '@fontsource/bebas-neue';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';

import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/global.css';

import { site } from '../data/site';
import Nav from '../components/Nav.astro';
import WppFab from '../components/WppFab.astro';

export interface Props {
  title: string;
  description?: string;
  /** Override do H1 usado na home/páginas filhas (renderiza como sr-only se fornecido). */
  h1?: string;
  /** Open Graph image absoluta. Default: 1ª foto. */
  ogImage?: string;
  /** Se true, omite o <h1> no conteúdo (a página controla). */
  h1Only?: boolean;
}

const {
  title,
  description = site.descricao,
  h1,
  ogImage = '/photos/og-default.jpg',
  h1Only = false,
} = Astro.props;

const fullTitle = title.includes(site.nome) ? title : `${title} | ${site.nome}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? site.url).toString();
const atualizadoEm = site.atualizadoEm;

// JSON-LD: LocalBusiness + Person (Helena).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${site.url}#business`,
      name: site.nome,
      description: description,
      url: site.url,
      telephone: site.whatsappE164,
      areaServed: site.regiao.map((c) => ({
        '@type': 'City',
        name: c,
      })),
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.cidade,
        addressRegion: site.uf,
        addressCountry: 'BR',
      },
      priceRange: '$$',
    },
    {
      '@type': 'Person',
      '@id': `${site.url}#helena`,
      name: site.nome,
      jobTitle: 'Instrutora autônoma de direção',
      worksFor: { '@id': `${site.url}#business` },
      telephone: site.whatsappE164,
      areaServed: site.regiao as unknown as string,
    },
  ],
};
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0e0e10" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.nome} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {site.analytics.scriptUrl && site.analytics.websiteId && (
      <script is:inline defer src={site.analytics.scriptUrl} data-website-id={site.analytics.websiteId}></script>
    )}

    {/* JSON-LD */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Favicon — pendente definir em etapa futura */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a href="#main" class="skip-link">Pular para o conteúdo</a>
    <Nav />
    <main id="main">
      {h1 && !h1Only && <h1 class="sr-only">{h1}</h1>}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          © {new Date().getFullYear()} {site.nome}. {site.validade}.
          Última atualização: <time datetime={atualizadoEm}>{atualizadoEm.split('-').reverse().join('/')}</time>.
        </p>
        <p>
          <a href="/politica-de-privacidade">Política de Privacidade</a>
          {' · '}
          <a href="/primeira-habilitacao-sp">Passo a passo da primeira habilitação</a>
          {' · '}
          <a
            href={site.instagramLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Instagram da ${site.nome} (@${site.instagram})`}
          >
            Instagram (@{site.instagram})
          </a>
        </p>
      </div>
    </footer>
    <WppFab />

    <style>
      .site-footer {
        margin-top: var(--space-9);
        padding: var(--space-7) 0;
        background: var(--ink);
        color: var(--paper);
        font-size: var(--text-sm);
      }
      .site-footer p {
        max-width: none;
      }
      .site-footer a {
        color: var(--paper);
        text-decoration: underline;
      }
      .site-footer a:hover {
        text-decoration: underline;
      }
      .site-footer .container > * + * {
        margin-top: var(--space-3);
      }
    </style>
  </body>
</html>
